# Sports Agency Dashboard — environment template.
# Copy to `.env` for local dev. With NOTHING set, the app runs on mock data.

# Backend: 'mock' (default) or 'airtable'
VITE_BACKEND=mock

# Auth provider: 'mock' (default) or 'supabase'
VITE_AUTH=mock

# Debug logging: 'true' enables logger.debug output
VITE_DEBUG=false

# ── Supabase auth (only when VITE_AUTH=supabase) ────────────────────
# The anon key is public by design — Supabase Row-Level Security is the
# real access boundary and MUST be configured on the project.
# User role / recruiterId / athleteId are read from user_metadata.
# VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=

# ── Airtable backend (only when VITE_BACKEND=airtable) ──────────────
# VITE_AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
#
# PRODUCTION: route Airtable calls through a serverless proxy so the
# token stays server-side. A VITE_ var is bundled into client JS — it
# is NOT secret.
# VITE_AIRTABLE_PROXY_URL=https://your-app.example.com/api/airtable
#
# LOCAL DEV ONLY: a direct token. Never commit a real value.
# VITE_AIRTABLE_API_KEY=
